# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database
DATABASE_URL=sqlite:///data/database/quant_vn.db

# Data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# API keys (for future paid data providers)
# FIREANT_API_KEY=
# VNDIRECT_API_KEY=
# SSI_API_KEY=

# Logging
LOG_LEVEL=INFO
