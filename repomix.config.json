{
  "output": {
    "filePath": "ai-context/repomix-output.md",
    "style": "markdown",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "topFilesLength": 20
  },
  "include": [
    "src/**/*",
    "datapipe/src/**/*",
    "datapipe/tests/**/*",
    "datapipe/config/**/*.yaml",
    "datapipe/README.md",
    "datapipe/pyproject.toml",
    "datapipe/Makefile",
    "datapipe/.env.example",
    "quant/src/**/*",
    "quant/tests/**/*",
    "quant/config/**/*.yaml",
    "quant/README.md",
    "quant/pyproject.toml",
    "quant/Makefile",
    "quant/.env.example",
    "docs/**/*",
    "guide/**/*",
    "tests/**/*",
    "tests/fixtures/*.csv",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "Makefile",
    ".claude/settings.json"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "node_modules/**",
      ".git/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".cache/**",
      "logs/**",
      "tmp/**",
      "ai-context/**",
      "data/raw/**",
      "data/processed/**",
      "data/cache/**",
      "data/vendor/**",
      "datapipe/data/**",
      "quant/data/**",
      "db/**",
      "*.csv",
      "!tests/fixtures/*.csv",
      "!**/tests/fixtures/*.csv",
      "*.parquet",
      "*.duckdb",
      "*.sqlite",
      "*.sqlite3",
      "*.db",
      "*.log",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.webp",
      "*.pdf",
      "*.zip"
    ]
  }
}
