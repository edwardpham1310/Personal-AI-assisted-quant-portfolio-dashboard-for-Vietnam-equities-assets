# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# ── Frontend (exposed to the browser; safe to publish) ──────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://kuuzxogorezotkflzmpz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Build-time environment label inlined into the browser bundle. Set to
# "production" on Cloudflare Pages so ``useAsyncResource`` enforces the
# Phase 2A rule "no silent mock fallback when the live fetch fails".
# Leave blank (defaults to "development") for local dev so the legacy
# mock-backed dashboard tiles keep rendering offline.
NEXT_PUBLIC_APP_ENV=development

# ── Backend ─────────────────────────────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Supabase (server-only secrets) ──────────────────────────────────────────
SUPABASE_URL=https://kuuzxogorezotkflzmpz.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:<SUPABASE_DB_PASSWORD>@db.kuuzxogorezotkflzmpz.supabase.co:5432/postgres

# ── SSI FastConnect Data (read-only, server-only — NEVER expose to frontend) ─
# These two keys authorise read-only market-data calls only.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_BASE_URL=https://fc-data.ssi.com.vn
SSI_TIMEOUT_SECONDS=10
SSI_MAX_RETRIES=3
# Default to mock mode: the API runs end-to-end without any real SSI
# credentials. Flip to false in production after credentials are loaded
# on the API host's secret manager.
SSI_USE_MOCK=true
# Quotes older than this many seconds are flagged stale: true in the response.
SSI_QUOTE_STALE_SECONDS=60

# ── SSI FastConnect Trading — PHASE 2 PLACEHOLDERS ─────────────────────────
# These keys may be populated locally for a future read-only sync milestone,
# but Phase 1 MUST NOT use them for order placement. No code path under
# apps/api/src/ currently instantiates a Trading provider — see the security
# checklist before wiring any /orders endpoint.
SSI_TRADING_BASE_URL=https://fc-tradeapi.ssi.com.vn
SSI_TRADING_CONSUMER_ID=
SSI_TRADING_CONSUMER_SECRET=

# ── Redis / Upstash ─────────────────────────────────────────────────────────
# REDIS_URL may be left blank; the API falls back to an in-memory cache.
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Market poller ───────────────────────────────────────────────────────────
# Off by default — turning this on starts the background SSI polling task.
ENABLE_MARKET_POLLER=false
MARKET_POLL_INTERVAL_SECONDS=15
WATCHLIST_POLL_INTERVAL_SECONDS=10
FULL_MARKET_POLL_INTERVAL_SECONDS=300
QUOTE_CACHE_TTL_SECONDS=30
INDEX_CACHE_TTL_SECONDS=30
TOP_MOVERS_CACHE_TTL_SECONDS=60
# Always-polled symbols (CSV). Live SSE streams add their own on subscribe.
MARKET_CORE_SYMBOLS=FPT,MWG,HPG,VNM,VCB,VRE
MARKET_CORE_INDICES=VNINDEX,VN30

# ── Local data paths ────────────────────────────────────────────────────────
DUCKDB_PATH=./data/duckdb/quant_vn.duckdb
PARQUET_DATA_DIR=./data/parquet
