#!/usr/bin/env bash
# fly-secrets.sh.template — Real-SSI read-only MVP backend secrets
#
# Phase 3a template. PLACEHOLDERS ONLY. No real secret values may
# live in this file (it is committed to the repo).
#
# How to use:
#   The `*.env.local` rule that protects the filled copy lives in
#   ``quant-vn-dashboard/.gitignore`` — NOT in the workspace-root
#   ``.gitignore``. The filled copy MUST therefore live inside
#   ``quant-vn-dashboard/`` for ignore protection to apply. Every step
#   below uses that directory explicitly.
#
#   1. Change into the dashboard sub-repo:
#        cd quant-vn-dashboard
#   2. Copy the template (DO NOT edit the template in-place):
#        cp scripts/fly-secrets.sh.template fly-secrets.env.local
#   3. Verify the file IS gitignored before doing anything else:
#        git check-ignore -v fly-secrets.env.local
#      Expected: ``quant-vn-dashboard/.gitignore:5:*.env.local <file>``
#      If git does NOT report a match, STOP — the file is at the wrong
#      level and a `git add` would stage it.
#   4. Open fly-secrets.env.local in your editor and replace every
#      ``__REPLACE_WITH_*__`` placeholder with the real value from the
#      named source (Supabase dashboard, SSI portal, your records).
#   5. Restrict permissions so the file is operator-only:
#        chmod 600 fly-secrets.env.local
#   6. Run it (still from inside quant-vn-dashboard/):
#        bash fly-secrets.env.local
#      This invokes ``flyctl secrets set`` once with every value. Fly
#      rolls the app after secrets land.
#   7. Verify the names appear in Fly without printing values:
#        flyctl secrets list --app quant-vn-api
#   8. Delete the filled copy when you no longer need it:
#        shred -u fly-secrets.env.local   # Linux
#        rm -P fly-secrets.env.local      # macOS (overwrite-then-unlink)
#
# DO NOT:
#   * Commit fly-secrets.env.local — it is gitignored for a reason.
#   * Paste its contents into chat, screenshots, or screen-share.
#   * Leave it on a shared workstation.
#   * Reuse the same secrets between staging and production.
#
# Where each value comes from:
#   - SUPABASE_*               Supabase dashboard → Project Settings → API
#   - DATABASE_URL             Supabase dashboard → Project Settings →
#                              Database → Connection string (Postgres URI form)
#   - SSI_CONSUMER_ID/SECRET   SSI FastConnect portal → app credentials
#                              (FCData product — NOT FCtrading)
#   - CORS_ORIGINS             The HTTPS URL of your Cloudflare Pages
#                              deployment, JSON-array form
#
# All trading + auto-trade flags are pinned to safe-disabled values
# below and MUST stay that way for this MVP. Each Settings flag has
# a corresponding `_assert_production_*` startup guard in
# `apps/api/src/core/config.py` that refuses to boot if flipped.

set -euo pipefail

APP="${FLY_APP:-quant-vn-api}"

# Friendly preflight — refuse to run if any placeholder is still present.
required_substrings=(
    "__REPLACE_WITH_PAGES_URL__"
    "__REPLACE_WITH_SUPABASE_URL__"
    "__REPLACE_WITH_SUPABASE_JWT_SECRET__"
    "__REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY__"
    "__REPLACE_WITH_DATABASE_URL__"
    "__REPLACE_WITH_SSI_CONSUMER_ID__"
    "__REPLACE_WITH_SSI_CONSUMER_SECRET__"
)
for ph in "${required_substrings[@]}"; do
    if grep -q "$ph" "$0"; then
        printf 'ERROR: placeholder still present: %s\n' "$ph" >&2
        printf 'Edit this file and replace every __REPLACE_WITH_*__ before running.\n' >&2
        exit 1
    fi
done

flyctl secrets set \
    APP_ENV="production" \
    CORS_ORIGINS='["__REPLACE_WITH_PAGES_URL__"]' \
    LOG_LEVEL="INFO" \
    \
    `# ── Supabase (server-only) ──` \
    SUPABASE_URL="__REPLACE_WITH_SUPABASE_URL__" \
    SUPABASE_JWT_SECRET="__REPLACE_WITH_SUPABASE_JWT_SECRET__" \
    SUPABASE_SERVICE_ROLE_KEY="__REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY__" \
    DATABASE_URL="__REPLACE_WITH_DATABASE_URL__" \
    \
    `# ── SSI FCData (read-only market data) ──` \
    SSI_USE_MOCK="false" \
    SSI_CONSUMER_ID="__REPLACE_WITH_SSI_CONSUMER_ID__" \
    SSI_CONSUMER_SECRET="__REPLACE_WITH_SSI_CONSUMER_SECRET__" \
    SSI_QUOTE_STALE_SECONDS="60" \
    \
    `# ── Market poller (real-data hot cache) ──` \
    ENABLE_MARKET_POLLER="true" \
    MARKET_POLL_INTERVAL_SECONDS="15" \
    QUOTE_CACHE_TTL_SECONDS="30" \
    INDEX_CACHE_TTL_SECONDS="30" \
    MARKET_CORE_SYMBOLS='["FPT","MWG","HPG","VNM","VCB","VRE"]' \
    MARKET_CORE_INDICES='["VNINDEX","VN30"]' \
    \
    `# ── Trading: live order placement DISABLED (must stay false) ──` \
    TRADING_LIVE_ORDER_ENABLED="false" \
    TRADING_MANUAL_CONFIRM_ENABLED="false" \
    TRADING_ORDER_PLACEMENT_DRY_RUN="true" \
    \
    `# ── SSI Trading: order placement DISABLED (must stay false/true mock) ──` \
    SSI_TRADING_USE_MOCK="true" \
    SSI_TRADING_READ_ONLY="true" \
    SSI_TRADING_ORDER_PLACEMENT_ENABLED="false" \
    \
    `# ── Auto-trade: completely DISABLED (must stay false/OFF) ──` \
    AUTO_TRADE_ENABLED="false" \
    AUTO_TRADE_LIVE_ENABLED="false" \
    AUTO_TRADE_ORDER_PLACEMENT_ENABLED="false" \
    AUTO_TRADE_DRY_RUN="true" \
    AUTO_TRADE_WORKER_ENABLED="false" \
    AUTO_TRADE_DEFAULT_MODE="OFF" \
    \
    --app "$APP"

printf '\nflyctl secrets set: OK\n'
printf 'Verify (no values printed, only names + digests):\n'
printf '    flyctl secrets list --app %s\n' "$APP"
printf '\nNext: deploy with\n'
printf '    flyctl deploy --image-label "$(git rev-parse --short HEAD)" --app %s\n' "$APP"
printf '\nAfter deploy, smoke check:\n'
printf '    API_BASE_URL=https://%s.fly.dev JWT=<paste in shell, not chat> make deploy-check\n' "$APP"
